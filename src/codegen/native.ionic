// ── codegen.ionic ─────────────────────────────────────────────────────────────
// ARM64 (AArch64) machine-code emitter + Mach-O relocatable object writer.
// Integrated with compiler.ionic: shares the global node arrays (nd_kind, etc.)
// and is concatenated with it at build time.
//
// Entry point: codegen_program(structs_list, fns_list, top_list, out_path)
// Produces a valid Mach-O .o file that `ld` can link into a native binary.
// ─────────────────────────────────────────────────────────────────────────────

// ── Register numbers ─────────────────────────────────────────────────────────
let REG_X0  = 0;   let REG_X1  = 1;   let REG_X2  = 2;   let REG_X3  = 3;
let REG_X4  = 4;   let REG_X5  = 5;   let REG_X6  = 6;   let REG_X7  = 7;
let REG_X8  = 8;   let REG_X9  = 9;   let REG_X10 = 10;  let REG_X11 = 11;
let REG_X12 = 12;  let REG_X13 = 13;  let REG_X14 = 14;  let REG_X15 = 15;
let REG_X16 = 16;  let REG_X17 = 17;  let REG_X19 = 19;  let REG_X20 = 20;
let REG_X21 = 21;  let REG_X22 = 22;  let REG_X23 = 23;  let REG_X24 = 24;
let REG_X25 = 25;  let REG_X26 = 26;  let REG_X27 = 27;  let REG_X28 = 28;
let REG_X29 = 29;  let REG_X30 = 30;  let REG_XZR = 31;  let REG_SP  = 31;

// Condition codes for B.cond / CSET
let COND_EQ = 0;  let COND_NE = 1;
let COND_GE = 10; let COND_LT = 11;
let COND_GT = 12; let COND_LE = 13;

// ── Binary buffers ────────────────────────────────────────────────────────────
// text_buf: ARM64 instructions (.text section)
// data_buf: string literals (.cstring section)
mut text_buf = [0];
mut data_buf = [0];
mut ncg_has_user_main = 0;  // set when fn main() with no params is compiled
mut ncg_last_ty = 0;        // 0=int, 1=str, 2=float — updated by ncg_expr for print/println dispatch

// ── Global constant and variable tables ───────────────────────────────────────
// Integer constants (top-level immutable let X = integer_literal) are inlined.
mut const_names = [0];   // str_hash of name
mut const_vals  = [0];   // integer value
mut const_count = 0;
// Non-constant top-level globals go into __DATA,__data section.
mut glob_names  = [0];   // str_hash of name
mut glob_syms   = [0];   // symbol index
mut glob_is_str   = [0];   // 1 if this global holds a string type
mut glob_is_float = [0];   // 1 if this global holds a float64 type
mut glob_count  = 0;
mut glob_buf    = [0];   // raw bytes, 8 per slot (zero-initialized)

// Remove sentinel element — arrays start at index 1 via push
// Actually initialise properly:
fn buf_init() -> int64 {
    // Clear both buffers
    mut i = text_buf.len - 1;
    while (i >= 0) { i = i - 1; }   // just a no-op to use i
    return 0;
}

fn text_len() -> int64 { return text_buf.len; }
fn data_len() -> int64 { return data_buf.len; }

fn text_u8(int64 b) -> int64 {
    text_buf.push(b & 255);
    return 0;
}

fn data_u8(int64 b) -> int64 {
    data_buf.push(b & 255);
    return 0;
}

// Emit a 32-bit little-endian instruction word into text
fn text_u32(int64 w) -> int64 {
    text_buf.push(w & 255);
    text_buf.push((w >> 8) & 255);
    text_buf.push((w >> 16) & 255);
    text_buf.push((w >> 24) & 255);
    return 0;
}

// Emit a 64-bit little-endian word
fn buf_u64([int64] buf, int64 v) -> int64 {
    buf.push(v & 255);
    buf.push((v >> 8) & 255);
    buf.push((v >> 16) & 255);
    buf.push((v >> 24) & 255);
    buf.push((v >> 32) & 255);
    buf.push((v >> 40) & 255);
    buf.push((v >> 48) & 255);
    buf.push((v >> 56) & 255);
    return 0;
}

fn buf_u32([int64] buf, int64 v) -> int64 {
    buf.push(v & 255);
    buf.push((v >> 8) & 255);
    buf.push((v >> 16) & 255);
    buf.push((v >> 24) & 255);
    return 0;
}

fn buf_u16([int64] buf, int64 v) -> int64 {
    buf.push(v & 255);
    buf.push((v >> 8) & 255);
    return 0;
}

fn buf_u8b([int64] buf, int64 v) -> int64 {
    buf.push(v & 255);
    return 0;
}

// Pad buffer to alignment (power-of-2)
fn buf_align([int64] buf, int64 align) -> int64 {
    mut n = buf.len;
    let mask = align - 1;
    while ((n & mask) != 0) {
        buf.push(0);
        n = n + 1;
    }
    return 0;
}

// Write null-terminated C string into a buffer; return start offset
fn buf_cstr([int64] buf, string s) -> int64 {
    let off = buf.len;
    let n = str_len(s);
    mut i = 0;
    while (i < n) {
        buf.push(str_index(s, i) & 255);
        i = i + 1;
    }
    buf.push(0);   // null terminator
    return off;
}

// ── Relocation table ──────────────────────────────────────────────────────────
// Each relocation: [text_offset, sym_idx, type, pcrel, extern_flag]
// Stored as flat [int64] in groups of 5
let RELOC_STRIDE = 5;
let RELOC_BRANCH26    = 2;   // ARM64_RELOC_BRANCH26
let RELOC_PAGE21      = 3;   // ARM64_RELOC_PAGE21
let RELOC_PAGEOFF12   = 4;   // ARM64_RELOC_PAGEOFF12
let RELOC_UNSIGNED    = 0;
mut reloc_buf = [0];
mut reloc_count = 0;

fn reloc_add(int64 text_off, int64 sym_idx, int64 rtype, int64 pcrel, int64 ext) -> int64 {
    reloc_buf.push(text_off);
    reloc_buf.push(sym_idx);
    reloc_buf.push(rtype);
    reloc_buf.push(pcrel);
    reloc_buf.push(ext);
    reloc_count = reloc_count + 1;
    return 0;
}

// ── Symbol table ──────────────────────────────────────────────────────────────
// Each symbol: [strtab_off, type, sect, desc, value_lo, value_hi]
// type: 0x0F = N_SECT|N_EXT (defined global), 0x01 = N_EXT (undefined)
let SYM_STRIDE  = 6;
let SYM_DEFINED = 15;   // 0x0F
let SYM_UNDEF   = 1;    // 0x01  (N_EXT | N_UNDF)
mut sym_buf      = [0];
mut sym_count    = 0;
mut strtab_buf   = [0];
mut strtab_len   = 0;

fn strtab_init() -> int64 {
    // After arr_reset, strtab_buf is empty. Push the required leading null byte.
    strtab_buf.push(0);
    strtab_len = 1;
    return 0;
}

fn strtab_add(string name) -> int64 {
    let off = strtab_len;
    // Prepend underscore (Mach-O C symbol convention)
    strtab_buf.push(95);   // '_'
    let n = str_len(name);
    mut i = 0;
    while (i < n) {
        strtab_buf.push(str_index(name, i) & 255);
        i = i + 1;
    }
    strtab_buf.push(0);
    strtab_len = strtab_buf.len;
    return off;
}

fn sym_add(string name, int64 sym_type, int64 sect, int64 value) -> int64 {
    let str_off = strtab_add(name);
    sym_buf.push(str_off);
    sym_buf.push(sym_type);
    sym_buf.push(sect);
    sym_buf.push(0);          // n_desc
    sym_buf.push(value);      // value lo (we only need 32-bit for .o)
    sym_buf.push(0);          // value hi
    sym_count = sym_count + 1;
    return sym_count - 1;     // return symbol index
}

// Undefined external symbol (call to libc, ORT, etc.)
// Returns symbol index; deduplicates by linear scan
mut undef_names  = [0];   // string pool indices — not useful as [int64]
mut undef_sym_idx = [0];  // parallel: actual symbol table index
mut undef_count  = 0;

fn sym_undef(string name) -> int64 {
    // linear scan for existing entry
    mut i = 0;
    while (i < undef_count) {
        // We can't store strings in [int64], so use the sym index approach:
        // check by looking up the strtab entry would be complex — skip dedup for now
        // TODO: dedup; for now always add (linker deduplicates)
        i = undef_count;   // break
    }
    return sym_add(name, SYM_UNDEF, 0, 0);
}

// ── String literal pool ───────────────────────────────────────────────────────
// String literals go into __cstring (__TEXT segment, section 2).
mut cstr_offsets = [0];   // offset of each string in data_buf
mut cstr_count   = 0;

fn cstr_intern(string s) -> int64 {
    // buf_cstr returns data_buf.len before push — correct section offset since arr_reset cleared it.
    let off = buf_cstr(data_buf, s);
    cstr_offsets.push(off);
    cstr_count = cstr_count + 1;
    return cstr_count - 1;   // cstring pool index (0-based)
}

// ── ARM64 instruction emitters ───────────────────────────────────────────────

// ADD Xd, Xn, Xm
fn a64_add(int64 rd, int64 rn, int64 rm) -> int64 {
    return text_u32(0x8B000000 | (rm << 16) | (rn << 5) | rd);
}
// SUB Xd, Xn, Xm
fn a64_sub(int64 rd, int64 rn, int64 rm) -> int64 {
    return text_u32(0xCB000000 | (rm << 16) | (rn << 5) | rd);
}
// MUL Xd, Xn, Xm  (MADD Xd, Xn, Xm, XZR)
fn a64_mul(int64 rd, int64 rn, int64 rm) -> int64 {
    return text_u32(0x9B007C00 | (rm << 16) | (rn << 5) | rd);
}
// SDIV Xd, Xn, Xm
fn a64_sdiv(int64 rd, int64 rn, int64 rm) -> int64 {
    return text_u32(0x9AC00C00 | (rm << 16) | (rn << 5) | rd);
}
// AND Xd, Xn, Xm
fn a64_and(int64 rd, int64 rn, int64 rm) -> int64 {
    return text_u32(0x8A000000 | (rm << 16) | (rn << 5) | rd);
}
// ORR Xd, Xn, Xm
fn a64_orr(int64 rd, int64 rn, int64 rm) -> int64 {
    return text_u32(0xAA000000 | (rm << 16) | (rn << 5) | rd);
}
// EOR Xd, Xn, Xm
fn a64_eor(int64 rd, int64 rn, int64 rm) -> int64 {
    return text_u32(0xCA000000 | (rm << 16) | (rn << 5) | rd);
}
// LSL Xd, Xn, Xm  (LSLV)
fn a64_lsl(int64 rd, int64 rn, int64 rm) -> int64 {
    return text_u32(0x9AC02000 | (rm << 16) | (rn << 5) | rd);
}
// ASR Xd, Xn, Xm  (ASRV)
fn a64_asr(int64 rd, int64 rn, int64 rm) -> int64 {
    return text_u32(0x9AC02800 | (rm << 16) | (rn << 5) | rd);
}
// MOV Xd, Xn  (ORR Xd, XZR, Xn)
fn a64_mov(int64 rd, int64 rn) -> int64 {
    return text_u32(0xAA0003E0 | (rn << 16) | rd);
}
// CMP Xn, Xm  (SUBS XZR, Xn, Xm)
fn a64_cmp(int64 rn, int64 rm) -> int64 {
    return text_u32(0xEB000000 | (rm << 16) | (rn << 5) | REG_XZR);
}
// NEG Xd, Xm  (SUB Xd, XZR, Xm)
fn a64_neg(int64 rd, int64 rm) -> int64 {
    return text_u32(0xCB0003E0 | (rm << 16) | rd);
}
// MVN Xd, Xm  (ORN Xd, XZR, Xm)
fn a64_mvn(int64 rd, int64 rm) -> int64 {
    return text_u32(0xAA2003E0 | (rm << 16) | rd);
}

// MOVZ Xd, #imm16, LSL #(shift*16)   shift in {0,1,2,3}
fn a64_movz(int64 rd, int64 imm16, int64 shift) -> int64 {
    return text_u32(0xD2800000 | (shift << 21) | ((imm16 & 65535) << 5) | rd);
}
// MOVK Xd, #imm16, LSL #(shift*16)
fn a64_movk(int64 rd, int64 imm16, int64 shift) -> int64 {
    return text_u32(0xF2800000 | (shift << 21) | ((imm16 & 65535) << 5) | rd);
}
// ADD Xd, Xn, #imm12
fn a64_add_imm(int64 rd, int64 rn, int64 imm12) -> int64 {
    return text_u32(0x91000000 | ((imm12 & 4095) << 10) | (rn << 5) | rd);
}
// SUB Xd, Xn, #imm12
fn a64_sub_imm(int64 rd, int64 rn, int64 imm12) -> int64 {
    return text_u32(0xD1000000 | ((imm12 & 4095) << 10) | (rn << 5) | rd);
}
// CMP Xn, #imm12
fn a64_cmp_imm(int64 rn, int64 imm12) -> int64 {
    return text_u32(0xF1000000 | ((imm12 & 4095) << 10) | (rn << 5) | REG_XZR);
}

// LDR Xt, [Xn, #imm9]  (signed unscaled offset — LDUR)
fn a64_ldur(int64 rt, int64 rn, int64 imm9) -> int64 {
    let imm = imm9 & 511;
    return text_u32(0xF8400000 | (imm << 12) | (rn << 5) | rt);
}
// STR Xt, [Xn, #imm9]  (signed unscaled — STUR)
fn a64_stur(int64 rt, int64 rn, int64 imm9) -> int64 {
    let imm = imm9 & 511;
    return text_u32(0xF8000000 | (imm << 12) | (rn << 5) | rt);
}
// Store/load a local variable at a positive byte offset from X29.
// Uses STUR (unscaled, fits ≤255) or STR (scaled imm12, fits anything ≤32760).
fn a64_store_fp(int64 rt, int64 byte_off) -> int64 {
    if (byte_off <= 255) { return a64_stur(rt, REG_X29, byte_off); }
    return a64_str(rt, REG_X29, byte_off >> 3);
}
fn a64_load_fp(int64 rt, int64 byte_off) -> int64 {
    if (byte_off <= 255) { return a64_ldur(rt, REG_X29, byte_off); }
    return a64_ldr(rt, REG_X29, byte_off >> 3);
}
// LDR Xt, [Xn, #imm12*8]  (unsigned scaled)
fn a64_ldr(int64 rt, int64 rn, int64 imm12) -> int64 {
    return text_u32(0xF9400000 | ((imm12 & 4095) << 10) | (rn << 5) | rt);
}
// STR Xt, [Xn, #imm12*8]  (unsigned scaled)
fn a64_str(int64 rt, int64 rn, int64 imm12) -> int64 {
    return text_u32(0xF9000000 | ((imm12 & 4095) << 10) | (rn << 5) | rt);
}
// STP X1, X2, [Xn, #imm7*8]  (signed scaled pair)
fn a64_stp(int64 rt1, int64 rt2, int64 rn, int64 imm7) -> int64 {
    let imm = imm7 & 127;
    return text_u32(0xA9000000 | (imm << 15) | (rt2 << 10) | (rn << 5) | rt1);
}
// LDP X1, X2, [Xn, #imm7*8]
fn a64_ldp(int64 rt1, int64 rt2, int64 rn, int64 imm7) -> int64 {
    let imm = imm7 & 127;
    return text_u32(0xA9400000 | (imm << 15) | (rt2 << 10) | (rn << 5) | rt1);
}
// STP X1, X2, [Xn, #imm7*8]!  (pre-index)
fn a64_stp_pre(int64 rt1, int64 rt2, int64 rn, int64 imm7) -> int64 {
    let imm = imm7 & 127;
    return text_u32(0xA9800000 | (imm << 15) | (rt2 << 10) | (rn << 5) | rt1);
}
// LDP X1, X2, [Xn], #imm7*8  (post-index)
fn a64_ldp_post(int64 rt1, int64 rt2, int64 rn, int64 imm7) -> int64 {
    let imm = imm7 & 127;
    return text_u32(0xA8C00000 | (imm << 15) | (rt2 << 10) | (rn << 5) | rt1);
}

// RET
fn a64_ret() -> int64 {
    return text_u32(0xD65F03C0);
}
// NOP
fn a64_nop() -> int64 {
    return text_u32(0xD503201F);
}
// BRK #0
fn a64_brk() -> int64 {
    return text_u32(0xD4200000);
}

// B #offset  (offset in bytes, must be multiple of 4; encodes as imm26 = offset/4)
// Returns address of the instruction for patching
fn a64_b(int64 byte_offset) -> int64 {
    let off = (byte_offset >> 2) & 67108863;   // imm26
    let addr = text_len();
    text_u32(0x14000000 | off);
    return addr;
}
// BL with relocation (to external symbol sym_idx)
fn a64_bl_sym(int64 sym_idx) -> int64 {
    let off = text_len();
    reloc_add(off, sym_idx, RELOC_BRANCH26, 1, 1);
    text_u32(0x94000000);   // placeholder; linker fills the offset
    return off;
}
// B.cond #offset (offset in bytes)
fn a64_bcond(int64 cond, int64 byte_offset) -> int64 {
    let imm19 = (byte_offset >> 2) & 524287;
    let addr = text_len();
    text_u32(0x54000000 | (imm19 << 5) | cond);
    return addr;
}
// CBZ Xt, #offset
fn a64_cbz(int64 rt, int64 byte_offset) -> int64 {
    let imm19 = (byte_offset >> 2) & 524287;
    let addr = text_len();
    text_u32(0xB4000000 | (imm19 << 5) | rt);
    return addr;
}
// CBNZ Xt, #offset
fn a64_cbnz(int64 rt, int64 byte_offset) -> int64 {
    let imm19 = (byte_offset >> 2) & 524287;
    let addr = text_len();
    text_u32(0xB5000000 | (imm19 << 5) | rt);
    return addr;
}

// CSET Xd, cond  (CSINC Xd, XZR, XZR, invert_cond)
fn a64_cset(int64 rd, int64 cond) -> int64 {
    // inverted condition = cond ^ 1
    let icond = cond ^ 1;
    return text_u32(0x9A9F07E0 | (icond << 12) | rd);
}

// Patch a branch instruction at `patch_addr` to jump to `target_addr`
fn a64_patch_b(int64 patch_addr, int64 target_addr) -> int64 {
    let delta = target_addr - patch_addr;
    let imm26 = (delta >> 2) & 67108863;
    // Read current word, mask off imm26, OR in new offset
    let b0 = text_buf[patch_addr];
    let b1 = text_buf[patch_addr + 1];
    let b2 = text_buf[patch_addr + 2];
    let b3 = text_buf[patch_addr + 3];
    let old = b0 | (b1 << 8) | (b2 << 16) | (b3 << 24);
    let new = (old & 4227858432) | imm26;   // 0xFC000000 keeps opcode bits
    text_buf[patch_addr]     = new & 255;
    text_buf[patch_addr + 1] = (new >> 8) & 255;
    text_buf[patch_addr + 2] = (new >> 16) & 255;
    text_buf[patch_addr + 3] = (new >> 24) & 255;
    return 0;
}

// Patch a B.cond / CBZ / CBNZ at patch_addr (imm19 field)
fn a64_patch_bcond(int64 patch_addr, int64 target_addr) -> int64 {
    let delta = target_addr - patch_addr;
    let imm19 = (delta >> 2) & 524287;
    let b0 = text_buf[patch_addr];
    let b1 = text_buf[patch_addr + 1];
    let b2 = text_buf[patch_addr + 2];
    let b3 = text_buf[patch_addr + 3];
    let old = b0 | (b1 << 8) | (b2 << 16) | (b3 << 24);
    // imm19 lives in bits [23:5]; mask = 0xFF00001F
    let mask = 4278190111;   // 0xFF00001F — keep opcode + cond bits
    let new = (old & mask) | (imm19 << 5);
    text_buf[patch_addr]     = new & 255;
    text_buf[patch_addr + 1] = (new >> 8) & 255;
    text_buf[patch_addr + 2] = (new >> 16) & 255;
    text_buf[patch_addr + 3] = (new >> 24) & 255;
    return 0;
}

// Load any 64-bit immediate into rd using MOVZ + up to 3x MOVK
fn a64_load_imm(int64 rd, int64 val) -> int64 {
    let w0 = val & 65535;
    let w1 = (val >> 16) & 65535;
    let w2 = (val >> 32) & 65535;
    let w3 = (val >> 48) & 65535;
    a64_movz(rd, w0, 0);
    if (w1 != 0) { a64_movk(rd, w1, 1); }
    if (w2 != 0) { a64_movk(rd, w2, 2); }
    if (w3 != 0) { a64_movk(rd, w3, 3); }
    return 0;
}

// ADRP + ADD to load the address of a symbol (two relocations)
fn a64_adrp_add(int64 rd, int64 sym_idx) -> int64 {
    let adrp_off = text_len();
    reloc_add(adrp_off, sym_idx, RELOC_PAGE21, 1, 1);
    text_u32(0x90000000 | rd);   // ADRP Xd, 0 — linker fills page offset
    let add_off = text_len();
    reloc_add(add_off, sym_idx, RELOC_PAGEOFF12, 0, 1);
    text_u32(0x91000000 | (rd << 5) | rd);  // ADD Xd, Xd, 0 — linker fills pageoff
    return 0;
}

// ── Float (double) instructions ───────────────────────────────────────────────
// D-register index == X-register index (same numbering)
fn a64_fadd(int64 dd, int64 dn, int64 dm) -> int64 {
    return text_u32(0x1E602800 | (dm << 16) | (dn << 5) | dd);
}
fn a64_fsub(int64 dd, int64 dn, int64 dm) -> int64 {
    return text_u32(0x1E603800 | (dm << 16) | (dn << 5) | dd);
}
fn a64_fmul(int64 dd, int64 dn, int64 dm) -> int64 {
    return text_u32(0x1E600800 | (dm << 16) | (dn << 5) | dd);
}
fn a64_fdiv(int64 dd, int64 dn, int64 dm) -> int64 {
    return text_u32(0x1E601800 | (dm << 16) | (dn << 5) | dd);
}
fn a64_fcmp(int64 dn, int64 dm) -> int64 {
    return text_u32(0x1E602000 | (dm << 16) | (dn << 5));
}
fn a64_fneg(int64 dd, int64 dn) -> int64 {
    return text_u32(0x1E614000 | (dn << 5) | dd);
}
// SCVTF Dd, Xn  (int64 → float64)
fn a64_scvtf(int64 dd, int64 xn) -> int64 {
    return text_u32(0x9E620000 | (xn << 5) | dd);
}
// FCVTZS Xd, Dn  (float64 → int64, truncate)
fn a64_fcvtzs(int64 xd, int64 dn) -> int64 {
    return text_u32(0x9E780000 | (dn << 5) | xd);
}
// STR Dt, [Xn, #imm12*8]
fn a64_fstr(int64 dt, int64 rn, int64 imm12) -> int64 {
    return text_u32(0xFD000000 | ((imm12 & 4095) << 10) | (rn << 5) | dt);
}
// LDR Dt, [Xn, #imm12*8]
fn a64_fldr(int64 dt, int64 rn, int64 imm12) -> int64 {
    return text_u32(0xFD400000 | ((imm12 & 4095) << 10) | (rn << 5) | dt);
}
// STUR Dt, [Xn, #imm9]
fn a64_fstur(int64 dt, int64 rn, int64 imm9) -> int64 {
    let imm = imm9 & 511;
    return text_u32(0xFC000000 | (imm << 12) | (rn << 5) | dt);
}
// LDUR Dt, [Xn, #imm9]
fn a64_fldur(int64 dt, int64 rn, int64 imm9) -> int64 {
    let imm = imm9 & 511;
    return text_u32(0xFC400000 | (imm << 12) | (rn << 5) | dt);
}

// ── Per-function state ────────────────────────────────────────────────────────
// Local variable map: parallel arrays  (name → stack slot index)
mut local_names    = [0];   // string-hash of variable name
mut local_slots    = [0];   // stack slot index
mut local_is_float = [0];   // 1 if float64
mut local_is_str   = [0];   // 1 if string type
mut local_stypes   = [""];  // struct type name, or "" for non-struct locals
mut local_count    = 0;

// Tracks the struct type name of the most recently evaluated expression.
// Set by ncg_expr whenever it evaluates a struct-typed expression.
mut ncg_last_stype = "";

// ── Function return-struct-type table (populated by codegen_program) ─────────
mut fn_ret_stype_hashes = [0];   // str_hash(fname) for struct-returning fns
mut fn_ret_stypes       = [""];  // struct name returned
mut fn_ret_count        = 0;

fn ncg_fn_stype(string fname) -> string {
    let h = str_hash(fname);
    mut i = 0;
    while (i < fn_ret_count) {
        if (fn_ret_stype_hashes[i] == h) { return fn_ret_stypes[i]; }
        i = i + 1;
    }
    return "";
}

// Stack layout: X29 = frame pointer; locals at [X29, #-(slot+1)*8]
// Slot offset in bytes = -(slot+1)*8
fn local_offset(int64 slot) -> int64 {
    // Positive offset from X29 (which = SP after prologue).
    // Saved X29/X30 occupy [X29+0] and [X29+8]; locals start at [X29+16].
    return (slot + 2) * 8;
}

fn local_reset() -> int64 {
    local_count = 0;
    arr_reset(local_names);
    arr_reset(local_slots);
    arr_reset(local_is_float);
    arr_reset(local_is_str);
    arr_reset(local_stypes);
    n_csr = 0;
    csr_base_slot = 0;
    spill_base = 0;
    return 0;
}

// Simple string hash for name lookup (FNV-1a 32-bit, truncated)
fn str_hash(string s) -> int64 {
    mut h = 2166136261;
    let n = str_len(s);
    mut i = 0;
    while (i < n) {
        h = (h ^ str_index(s, i)) * 16777619;
        h = h & 4294967295;   // keep 32 bits
        i = i + 1;
    }
    return h;
}

fn local_find(string name) -> int64 {
    let h = str_hash(name);
    mut i = 0;
    mut found = -1;
    while (i < local_count) {
        if (local_names[i] == h) { found = local_slots[i]; }
        i = i + 1;
    }
    return found;
}

fn local_def(string name, int64 is_float) -> int64 {
    let slot = local_count;
    local_names.push(str_hash(name));
    local_slots.push(slot);
    local_is_float.push(is_float);
    local_is_str.push(0);
    local_stypes.push("");
    local_count = local_count + 1;
    return slot;
}

fn local_set_str(int64 slot, int64 is_str) -> int64 {
    local_is_str[slot] = is_str;
    return 0;
}

fn local_set_float(int64 slot, int64 is_flt) -> int64 {
    local_is_float[slot] = is_flt;
    return 0;
}

fn local_get_str(string name) -> int64 {
    let h = str_hash(name);
    mut i = 0;
    while (i < local_count) {
        if (local_names[i] == h) { return local_is_str[i]; }
        i = i + 1;
    }
    return 0;
}

fn local_set_stype(int64 slot, string stype) -> int64 {
    local_stypes[slot] = stype;
    return 0;
}

fn local_get_stype(string name) -> string {
    let h = str_hash(name);
    mut i = 0;
    while (i < local_count) {
        if (local_names[i] == h) { return local_stypes[i]; }
        i = i + 1;
    }
    return "";
}

fn local_is_float_slot(string name) -> int64 {
    let h = str_hash(name);
    mut i = 0;
    while (i < local_count) {
        if (local_names[i] == h) { return local_is_float[i]; }
        i = i + 1;
    }
    return 0;
}

// Frame size = rounded up to 16-byte alignment
fn frame_size(int64 n_locals) -> int64 {
    let raw = (n_locals + 2) * 8;   // +2 for saved X29,X30
    let aligned = (raw + 15) & 4294967280;  // round up to 16  (0xFFFFFFF0)
    return aligned;
}

// ── Global lookup helpers ─────────────────────────────────────────────────────
fn ncg_const_find(string name) -> int64 {
    let h = str_hash(name);
    mut i = 0;
    while (i < const_count) {
        if (const_names[i] == h) { return i; }
        i = i + 1;
    }
    return -1;
}

fn ncg_glob_find(string name) -> int64 {
    let h = str_hash(name);
    mut i = 0;
    while (i < glob_count) {
        if (glob_names[i] == h) { return i; }
        i = i + 1;
    }
    return -1;
}

// ── Expression codegen ────────────────────────────────────────────────────────
// ncg_expr returns the register number holding the result.
// Integer results land in integer regs (X9 default scratch).
// Float results land in float (D) regs (D9 default scratch).
// Callers must save/restore regs if needed; we use a simple "deepest first" scheme.

// Scratch register pool: X9-X15 for ints, D9-D15 for floats
mut scratch_depth = 0;

// Register allocator state (reset per function by local_reset)
mut n_csr        = 0;   // params promoted to X19..X(19+n_csr-1)
mut csr_base_slot = 0;  // slot index where CSR saves live in the frame
mut spill_base   = 0;   // slot index where scratch spill area begins

fn scratch_push() -> int64 {
    let r = REG_X9 + scratch_depth;
    scratch_depth = scratch_depth + 1;
    return r;
}

fn scratch_pop() -> int64 {
    scratch_depth = scratch_depth - 1;
    return REG_X9 + scratch_depth;
}

// ncg_expr: evaluate AST node, result in X9 (or D9 for float); returns reg used
fn ncg_expr(int64 node) -> int64 {
    let kind = nd_kind[node];

    if (kind == ND_INT) {
        let r = scratch_push();
        a64_load_imm(r, nd_iv[node]);
        ncg_last_ty = 0;
        return r;
    }

    if (kind == ND_FLOAT) {
        // Encode float64 bits as int64, then FMOV
        // nd_f stores the float — we need its bit pattern
        // Use a temp: store to stack, load as int, FMOV
        // Simpler: emit a constant in __data and load it
        // For now use the scratch int reg then FMOV
        let ri = scratch_push();
        // We'll represent the float64 via its raw bits stored in nd_iv
        // (the emitter must store float bits there)
        a64_load_imm(ri, nd_iv[node]);
        // FMOV Dd, Xn  (move GP bits to FP register)
        // D9 = D-reg 9, same index
        text_u32(0x9E670000 | (ri << 5) | ri);  // FMOV D{ri}, X{ri}
        ncg_last_ty = 2;
        return ri;  // caller knows it's float by type context
    }

    if (kind == ND_BOOL) {
        let r = scratch_push();
        a64_load_imm(r, nd_iv[node]);
        return r;
    }

    if (kind == ND_STR) {
        // Intern the string, emit ADRP+ADD with relocation to __cstring
        let str_val = nd_sv[node];
        let pool_idx = cstr_intern(str_val);
        // Add a symbol for this cstring offset
        let sym_name = str_concat("__str", int64_to_str(pool_idx));
        let sym_idx  = sym_add(sym_name, SYM_DEFINED, 2, cstr_offsets[pool_idx]);
        let r = scratch_push();
        a64_adrp_add(r, sym_idx);
        ncg_last_ty = 1;
        return r;
    }

    if (kind == ND_IDENT) {
        let name = nd_sv[node];
        ncg_last_stype = "";  // reset before early returns; overridden for struct-typed locals below

        // 1. Check compile-time constant table (top-level let X = integer_literal)
        let cki = ncg_const_find(name);
        if (cki >= 0) {
            let r = scratch_push();
            a64_load_imm(r, const_vals[cki]);
            return r;
        }

        // 2. Check local variable (function-scope) — must be before globals so that
        //    function parameters shadow top-level globals with the same name.
        let slot = local_find(name);
        if (slot >= 0) {
            let r = scratch_push();
            ncg_last_stype = local_get_stype(name);
            ncg_last_ty    = local_get_str(name);
            if (slot < n_csr) {
                // Register-promoted param: read from callee-saved reg X19+slot
                a64_mov(r, REG_X19 + slot);
            } else {
                let off = local_offset(slot);
                if (off >= 0) { a64_ldr(r, REG_X29, off >> 3); }
                else {
                    let neg = 0 - off;
                    if (neg <= 255) { a64_ldur(r, REG_X29, off); }
                    else {
                        a64_sub_imm(REG_X16, REG_X29, neg);
                        a64_ldr(r, REG_X16, 0);
                    }
                }
            }
            if (local_is_float_slot(name) == 1) {
                text_u32(0x9E670000 | (r << 5) | r);  // FMOV D{r}, X{r}
                ncg_last_ty = 2;
            }
            return r;
        }

        // 3. Check global variable table (top-level let/mut non-const)
        let gi = ncg_glob_find(name);
        if (gi >= 0) {
            let r = scratch_push();
            a64_adrp_add(REG_X16, glob_syms[gi]);
            a64_ldr(r, REG_X16, 0);
            if (glob_is_float[gi] == 1) {
                text_u32(0x9E670000 | (r << 5) | r);  // FMOV D{r}, X{r}
                ncg_last_ty = 2;
            } else {
                ncg_last_ty = glob_is_str[gi];
            }
            return r;
        }

        // 5. Undefined external global (linker will resolve)
        let r = scratch_push();
        let sym_name = str_concat("_g_", name);
        let sym_idx  = sym_undef(sym_name);
        a64_adrp_add(REG_X16, sym_idx);
        a64_ldr(r, REG_X16, 0);
        return r;
    }

    if (kind == ND_BINOP) {
        let op  = nd_iv[node];
        let lhs = nd_i2[node];
        let rhs = nd_i3[node];
        let lr = ncg_expr(lhs);
        let rr = ncg_expr(rhs);
        let dr = lr;   // result in left reg

        // Integer ops
        if (op == OP_ADD)    { a64_add(dr, lr, rr); }
        if (op == OP_SUB)    { a64_sub(dr, lr, rr); }
        if (op == OP_MUL)    { a64_mul(dr, lr, rr); }
        if (op == OP_DIV)    { a64_sdiv(dr, lr, rr); }
        if (op == OP_MOD) {
            // X = A - (A/B)*B
            a64_sdiv(REG_X16, lr, rr);
            a64_mul(REG_X16, REG_X16, rr);
            a64_sub(dr, lr, REG_X16);
        }
        if (op == OP_BITAND) { a64_and(dr, lr, rr); }
        if (op == OP_BITOR)  { a64_orr(dr, lr, rr); }
        if (op == OP_BITXOR) { a64_eor(dr, lr, rr); }
        if (op == OP_SHL)    { a64_lsl(dr, lr, rr); }
        if (op == OP_SHR)    { a64_asr(dr, lr, rr); }

        // Float ops — result in D{dr}; sync bits back to X{dr} for GP convention
        if (op == OP_FADD) { a64_fadd(dr, lr, rr); }
        if (op == OP_FSUB) { a64_fsub(dr, lr, rr); }
        if (op == OP_FMUL) { a64_fmul(dr, lr, rr); }
        if (op == OP_FDIV) { a64_fdiv(dr, lr, rr); }
        if (op == OP_FADD || op == OP_FSUB || op == OP_FMUL || op == OP_FDIV) {
            text_u32(0x9E660000 | (dr << 5) | dr);  // FMOV X{dr}, D{dr}
            ncg_last_ty = 2;
        }

        // Comparison → bool (0 or 1) in dr
        if (op == OP_EQEQ || op == OP_NEQ || op == OP_LT ||
            op == OP_GT || op == OP_LTEQ || op == OP_GTEQ) {
            a64_cmp(lr, rr);
            if (op == OP_EQEQ)  { a64_cset(dr, COND_EQ); }
            if (op == OP_NEQ) { a64_cset(dr, COND_NE); }
            if (op == OP_LT)  { a64_cset(dr, COND_LT); }
            if (op == OP_GT)  { a64_cset(dr, COND_GT); }
            if (op == OP_LTEQ) { a64_cset(dr, COND_LE); }
            if (op == OP_GTEQ) { a64_cset(dr, COND_GE); }
        }

        // Logical AND / OR (short-circuit not needed for simple eval)
        if (op == OP_AND) { a64_and(dr, lr, rr); }
        if (op == OP_OR)  { a64_orr(dr, lr, rr); }

        scratch_pop();   // free rr
        return dr;
    }

    if (kind == ND_UNOP) {
        let op  = nd_iv[node];
        let sub = nd_i2[node];
        let r   = ncg_expr(sub);
        if (op == OP_NEG) {
            if (ncg_last_ty == 2) {
                // Float negate: FNEG D{r}, D{r}; sync back to GP register
                text_u32(0x1E614000 | (r << 5) | r);    // FNEG D{r}, D{r}
                text_u32(0x9E660000 | (r << 5) | r);    // FMOV X{r}, D{r}
                ncg_last_ty = 2;
            } else {
                a64_neg(r, r);
            }
        }
        if (op == OP_NOT)    { a64_cmp_imm(r, 0); a64_cset(r, COND_EQ); }
        if (op == OP_BITNOT) { a64_mvn(r, r); }
        return r;
    }

    if (kind == ND_CALL) {
        // Spill live scratch registers (X9..X9+live-1) before call — they are caller-saved in ARM64 ABI.
        // Use headroom stack slots at [X29 + (local_count+2+i)*8] — positive, within the frame.
        let live = scratch_depth;
        mut spill_i = 0;
        while (spill_i < live) {
            let sreg = REG_X9 + spill_i;
            let soff = (spill_base + 2 +spill_i) * 8;
            a64_store_fp(sreg, soff);
            spill_i = spill_i + 1;
        }

        ncg_call(node);

        // Restore spilled scratch registers
        spill_i = 0;
        while (spill_i < live) {
            let sreg = REG_X9 + spill_i;
            let soff = (spill_base + 2 +spill_i) * 8;
            a64_load_fp(sreg, soff);
            spill_i = spill_i + 1;
        }

        let r = scratch_push();
        a64_mov(r, REG_X0);
        // For float-returning calls, bits are in X{r}; also populate D{r}
        if (ncg_last_ty == 2) {
            text_u32(0x9E670000 | (r << 5) | r);  // FMOV D{r}, X{r}
        }
        // Propagate struct return type so field accesses work
        ncg_last_stype = ncg_fn_stype(nd_sv[node]);
        return r;
    }

    // Method call: obj.method(args)  e.g. buf.push(v), arr.len()
    // ND_METHOD_CALL: sv=method, i2=receiver, i3=extra-args list
    if (kind == ND_METHOD_CALL) {
        let mc_method = nd_sv[node];
        let mc_recv   = nd_i2[node];
        let mc_xargs  = nd_i3[node];

        // Spill any live scratch registers
        let mc_live = scratch_depth;
        mut mc_si = 0;
        while (mc_si < mc_live) {
            a64_store_fp(REG_X9 + mc_si, (spill_base + 2 +mc_si) * 8);
            mc_si = mc_si + 1;
        }

        let mc_base = scratch_depth;

        // Receiver is arg 0
        ncg_expr(mc_recv);
        mut mc_argc = 1;

        // Remaining args follow receiver in the extra-args linked list
        mut mc_an = mc_xargs;
        while (mc_an != 0 && mc_argc < 8) {
            ncg_expr(nd_i2[mc_an]);
            mc_argc = mc_argc + 1;
            mc_an = nd_i3[mc_an];
        }

        // Move scratch regs to ABI regs x0..xN
        mut mc_mi = 0;
        while (mc_mi < mc_argc) {
            a64_mov(mc_mi, REG_X9 + mc_base + mc_mi);
            mc_mi = mc_mi + 1;
        }

        // Map method name to C runtime symbol
        mut mc_fn = mc_method;
        if (str_eq(mc_method, "push")) { mc_fn = "ionic_array_push"; }
        if (str_eq(mc_method, "len"))  { mc_fn = "ionic_array_len"; }
        let mc_sym = sym_undef(mc_fn);
        a64_bl_sym(mc_sym);

        // Pop arg scratch regs
        mut mc_pi = 0;
        while (mc_pi < mc_argc) {
            scratch_pop();
            mc_pi = mc_pi + 1;
        }

        // Restore spilled scratch registers
        mc_si = 0;
        while (mc_si < mc_live) {
            a64_load_fp(REG_X9 + mc_si, (spill_base + 2 +mc_si) * 8);
            mc_si = mc_si + 1;
        }

        let mc_r = scratch_push();
        a64_mov(mc_r, REG_X0);
        return mc_r;
    }

    // Array index: arr[idx]
    if (kind == ND_INDEX) {
        let arr_node = nd_i2[node];
        let idx_node = nd_i3[node];
        // Spill outer live regs BEFORE computing arr/idx — protects them across
        // both the sub-expression evaluations AND the BL ionic_array_get.
        let ndx_live = scratch_depth;
        mut ndx_si = 0;
        while (ndx_si < ndx_live) {
            a64_store_fp(REG_X9 + ndx_si, (spill_base + 2 +ndx_si) * 8);
            ndx_si = ndx_si + 1;
        }
        let arr_r = ncg_expr(arr_node);
        let idx_r = ncg_expr(idx_node);
        // ionic_array_get(ptr arr, i64 idx) -> i64
        let sym = sym_undef("ionic_array_get");
        a64_mov(REG_X0, arr_r);
        a64_mov(REG_X1, idx_r);
        a64_bl_sym(sym);
        scratch_pop();
        scratch_pop();
        // Restore outer live regs AFTER the BL (BL clobbers all caller-saved regs)
        ndx_si = 0;
        while (ndx_si < ndx_live) {
            a64_load_fp(REG_X9 + ndx_si, (spill_base + 2 +ndx_si) * 8);
            ndx_si = ndx_si + 1;
        }
        let r = scratch_push();
        a64_mov(r, REG_X0);
        return r;
    }

    // Field access .len on array/string, or struct field
    if (kind == ND_FIELD_ACCESS) {
        let obj_node = nd_i2[node];
        let field    = nd_sv[node];
        if (str_eq(field, "len")) {
            // .len calls ionic_array_len which clobbers caller-saved regs —
            // spill outer live regs before eval+call, restore after.
            let len_live = scratch_depth;
            mut len_si = 0;
            while (len_si < len_live) {
                a64_store_fp(REG_X9 + len_si, (spill_base + 2 +len_si) * 8);
                len_si = len_si + 1;
            }
            let obj_r = ncg_expr(obj_node);
            let sym = sym_undef("ionic_array_len");
            a64_mov(REG_X0, obj_r);
            a64_bl_sym(sym);
            scratch_pop();
            len_si = 0;
            while (len_si < len_live) {
                a64_load_fp(REG_X9 + len_si, (spill_base + 2 +len_si) * 8);
                len_si = len_si + 1;
            }
            let r = scratch_push();
            a64_mov(r, REG_X0);
            return r;
        }
        let obj_r    = ncg_expr(obj_node);
        // ncg_expr sets ncg_last_stype; capture it immediately before it's overwritten
        let sname_fa = ncg_last_stype;
        // Struct field: look up field index using the type tracked by ncg_last_stype.
        let st_fa = st_find(sname_fa);
        mut fidx = 0;
        if (st_fa != 0) {
            let fo = st_field_offset(st_fa, field);
            if (fo >= 0) { fidx = fo; }
        }
        let r = scratch_pop();
        let r2 = scratch_push();
        // LDR r2, [obj_r, #fidx * 8] (scaled imm12)
        a64_ldr(r2, obj_r, fidx);
        return r2;
    }

    // Struct literal: Name { field1: val1, ... }
    if (kind == ND_STRUCT_LIT) {
        let sname  = nd_sv[node];
        let st_idx = st_find(sname);
        mut nfields = 0;
        if (st_idx != 0) { nfields = st_sizes[st_idx]; }
        let byte_sz = nfields * 8;

        // Spill live scratch regs before malloc call
        let slive = scratch_depth;
        mut ssi = 0;
        while (ssi < slive) {
            a64_store_fp(REG_X9 + ssi, (spill_base + 2 +ssi) * 8);
            ssi = ssi + 1;
        }
        // malloc(byte_sz) — allocate struct on heap
        let mal_sym = sym_undef("malloc");
        a64_load_imm(REG_X0, byte_sz);
        a64_bl_sym(mal_sym);
        ssi = 0;
        while (ssi < slive) {
            a64_load_fp(REG_X9 + ssi, (spill_base + 2 +ssi) * 8);
            ssi = ssi + 1;
        }
        let ptr_r = scratch_push();
        a64_mov(ptr_r, REG_X0);

        // For each field: evaluate value and STR to [ptr + field_idx * 8]
        mut flist = nd_i2[node];
        mut fidx2 = 0;
        while (flist != 0) {
            let fnode   = nd_i2[flist];
            let fval_nd = nd_i2[fnode];
            let val_r   = ncg_expr(fval_nd);
            // ptr_r may have been spilled/restored within ncg_expr; re-load from scratch
            // (scratch stack: ptr_r is below val_r, so ptr_r = REG_X9 + scratch_depth - 2)
            let cur_ptr_r = REG_X9 + scratch_depth - 2;
            a64_str(val_r, cur_ptr_r, fidx2);
            scratch_pop();
            flist  = nd_i3[flist];
            fidx2  = fidx2 + 1;
        }
        ncg_last_stype = sname;   // propagate struct type
        return ptr_r;
    }

    // Array literal: [e0, e1, ...]
    if (kind == ND_ARRAY_LIT) {
        // Spill any live scratch regs before ionic_make_array call
        let live0 = scratch_depth;
        mut si0 = 0;
        while (si0 < live0) {
            let sreg = REG_X9 + si0;
            let soff = (spill_base + 2 +si0) * 8;
            a64_store_fp(sreg, soff);
            si0 = si0 + 1;
        }
        let make_sym = sym_undef("ionic_make_array");
        a64_bl_sym(make_sym);
        si0 = 0;
        while (si0 < live0) {
            let sreg = REG_X9 + si0;
            let soff = (spill_base + 2 +si0) * 8;
            a64_load_fp(sreg, soff);
            si0 = si0 + 1;
        }
        let arr_r = scratch_push();
        a64_mov(arr_r, REG_X0);

        let push_sym = sym_undef("ionic_array_push");
        mut elem = nd_i2[node];
        while (elem != 0) {
            let elem_nd = nd_i2[elem];
            let val_r = ncg_expr(elem_nd);
            // Spill all live regs (including arr_r and val_r) before push call
            let nlive = scratch_depth;
            mut si = 0;
            while (si < nlive) {
                let sreg = REG_X9 + si;
                let soff = (spill_base + 2 +si) * 8;
                a64_store_fp(sreg, soff);
                si = si + 1;
            }
            a64_mov(REG_X0, arr_r);
            a64_mov(REG_X1, val_r);
            a64_bl_sym(push_sym);
            si = 0;
            while (si < nlive) {
                let sreg = REG_X9 + si;
                let soff = (spill_base + 2 +si) * 8;
                a64_load_fp(sreg, soff);
                si = si + 1;
            }
            scratch_pop();
            elem = nd_i3[elem];
        }
        return arr_r;
    }

    // Tensor conversions — identity at the codegen level; type safety enforced by checker
    if (kind == ND_TO_GPU || kind == ND_TO_CPU) {
        return ncg_expr(nd_i2[node]);
    }

    // Fallback
    let r = scratch_push();
    a64_load_imm(r, 0);
    return r;
}

// ── Call codegen ──────────────────────────────────────────────────────────────
fn ncg_call(int64 node) -> int64 {
    let callee = nd_sv[node];
    let args   = nd_i2[node];   // linked list of arg nodes

    // Reset type tracker before evaluating args
    ncg_last_ty = 0;

    // Phase 1: Evaluate all args into scratch registers WITHOUT popping between them.
    // This way each arg stays in X9+arg_base+i while later args are computed.
    // Sub-calls within arg evaluation will spill all live scratch (including earlier
    // args) via the ND_CALL path in ncg_expr, then restore them — so X9+arg_base+i
    // still has arg i's value when we reach Phase 2.
    let arg_base = scratch_depth;
    mut arg_node = args;
    mut arg_count = 0;
    while (arg_node != 0 && arg_count < 8) {
        let expr = nd_i2[arg_node];
        ncg_expr(expr);   // pushes result to scratch; depth increases by 1
        arg_node = nd_i3[arg_node];
        arg_count = arg_count + 1;
    }

    // Phase 2: Move computed args from scratch regs to ABI arg regs X0..X7.
    // Done after all args are computed so no later evaluation clobbers X0.
    mut move_i = 0;
    while (move_i < arg_count) {
        a64_mov(move_i, REG_X9 + arg_base + move_i);
        move_i = move_i + 1;
    }

    // For print/println, fix up ncg_last_ty based on first arg type.
    // Nested calls reset ncg_last_ty=0; correct it for known string-returning callees.
    if (str_eq(callee, "print") || str_eq(callee, "println")) {
        let fa = nd_i2[args];
        if (nd_kind[fa] == ND_CALL) {
            let inner = nd_sv[fa];
            if (str_eq(inner, "int64_to_str") || str_eq(inner, "float64_to_str") ||
                str_eq(inner, "char_to_str")  || str_eq(inner, "str_concat")     ||
                str_eq(inner, "get_arg")      || str_eq(inner, "file_read")      ||
                str_eq(inner, "format")       || str_eq(inner, "str_replace")    ||
                str_eq(inner, "str_slice")    || str_eq(inner, "read_line")      ||
                str_eq(inner, "str_hash_to_str")) {
                ncg_last_ty = 1;
            }
        }
        if (nd_kind[fa] == ND_STR) { ncg_last_ty = 1; }
        if (nd_kind[nd_i2[args]] == ND_METHOD_CALL) { ncg_last_ty = 1; }
    }

    // Remap Ionic builtin names → C runtime functions
    mut real_callee = callee;
    if (str_eq(callee, "main")) { real_callee = "ionic_user_main"; }
    if (str_eq(callee, "println")) {
        if (ncg_last_ty == 1)      { real_callee = "ionic_println"; }
        else if (ncg_last_ty == 2) { real_callee = "ionic_println_float64"; }
        else                       { real_callee = "ionic_println_int64"; }
    }
    if (str_eq(callee, "print")) {
        if (ncg_last_ty == 1)      { real_callee = "ionic_print"; }
        else if (ncg_last_ty == 2) { real_callee = "ionic_print_float64"; }
        else                       { real_callee = "ionic_print_int64"; }
    }
    if (str_eq(callee, "str_concat"))       { real_callee = "ionic_str_concat"; }
    if (str_eq(callee, "str_eq"))           { real_callee = "ionic_str_eq"; }
    if (str_eq(callee, "str_len"))          { real_callee = "ionic_str_len"; }
    if (str_eq(callee, "str_index"))        { real_callee = "ionic_str_index"; }
    if (str_eq(callee, "int64_to_str"))     { real_callee = "ionic_int64_to_str"; }
    if (str_eq(callee, "float64_to_str"))   { real_callee = "ionic_float64_to_str"; }
    if (str_eq(callee, "char_to_str"))      { real_callee = "ionic_char_to_str"; }
    if (str_eq(callee, "get_arg"))          { real_callee = "ionic_get_arg"; }
    if (str_eq(callee, "len"))              { real_callee = "ionic_array_len"; }
    if (str_eq(callee, "push"))             { real_callee = "ionic_array_push"; }
    if (str_eq(callee, "arr_reset"))        { real_callee = "ionic_arr_reset"; }
    if (str_eq(callee, "file_write"))         { real_callee = "ionic_file_write"; }
    if (str_eq(callee, "file_write_binary")) { real_callee = "ionic_file_write_binary"; }
    if (str_eq(callee, "file_read"))         { real_callee = "ionic_file_read"; }
    if (str_eq(callee, "system"))            { real_callee = "ionic_system"; }
    if (str_eq(callee, "sqrt"))              { real_callee = "ionic_sqrt"; }
    if (str_eq(callee, "fabs"))              { real_callee = "ionic_fabs"; }
    if (str_eq(callee, "int64_to_float64"))  { real_callee = "ionic_int64_to_float64"; }
    if (str_eq(callee, "float64_to_int64"))  { real_callee = "ionic_float64_to_int64"; }
    if (str_eq(callee, "str_to_int64"))      { real_callee = "ionic_str_to_int64"; }
    if (str_eq(callee, "str_hash"))          { real_callee = "ionic_str_hash"; }
    if (str_eq(callee, "cpu_core_count"))    { real_callee = "ionic_cpu_core_count"; }
    if (str_eq(callee, "exit"))              { real_callee = "ionic_exit"; }
    if (str_eq(callee, "read_line"))         { real_callee = "ionic_read_line"; }
    if (str_eq(callee, "str_slice"))         { real_callee = "ionic_str_slice"; }
    if (str_eq(callee, "str_contains"))      { real_callee = "ionic_str_contains"; }
    if (str_eq(callee, "str_starts_with"))   { real_callee = "ionic_str_starts_with"; }
    if (str_eq(callee, "str_ends_with"))     { real_callee = "ionic_str_ends_with"; }
    if (str_eq(callee, "str_replace"))       { real_callee = "ionic_str_replace"; }
    if (str_eq(callee, "format"))            { real_callee = "ionic_format"; }
    if (str_eq(callee, "min"))               { real_callee = "ionic_min"; }
    if (str_eq(callee, "max"))               { real_callee = "ionic_max"; }
    if (str_eq(callee, "abs"))               { real_callee = "ionic_abs"; }
    if (str_eq(callee, "pow"))               { real_callee = "ionic_pow"; }
    if (str_eq(callee, "floor"))             { real_callee = "ionic_floor"; }
    if (str_eq(callee, "ceil"))              { real_callee = "ionic_ceil"; }
    // ML / model inference
    if (str_eq(callee, "load_model"))        { real_callee = "ionic_load_model"; }
    if (str_eq(callee, "model_free"))        { real_callee = "ionic_model_free"; }
    if (str_eq(callee, "model_forward"))     { real_callee = "ionic_model_forward"; }
    if (str_eq(callee, "gguf_generate"))     { real_callee = "ionic_gguf_generate"; }
    if (str_eq(callee, "gguf_set_temp"))     { real_callee = "ionic_gguf_set_temp"; }
    if (str_eq(callee, "gguf_set_top_p"))    { real_callee = "ionic_gguf_set_top_p"; }
    if (str_eq(callee, "piper_forward"))     { real_callee = "ionic_piper_forward"; }
    if (str_eq(callee, "write_wav"))         { real_callee = "ionic_write_wav"; }

    // Phase 3: Emit BL with relocation
    let sym = sym_undef(real_callee);
    a64_bl_sym(sym);

    // Phase 4: Pop all arg scratch registers
    mut pop_i = 0;
    while (pop_i < arg_count) {
        scratch_pop();
        pop_i = pop_i + 1;
    }

    // Track return type so callers (especially println/print) pick the right variant.
    // Default to 0 (int64/void); set to 1 for string, 2 for float64.
    ncg_last_ty = 0;
    if (str_eq(callee, "str_concat")     || str_eq(callee, "int64_to_str")  ||
        str_eq(callee, "float64_to_str") || str_eq(callee, "char_to_str")   ||
        str_eq(callee, "get_arg")        || str_eq(callee, "file_read")     ||
        str_eq(callee, "str_slice")      || str_eq(callee, "read_line")    ||
        str_eq(callee, "str_replace")    || str_eq(callee, "format")) {
        ncg_last_ty = 1;
    }
    if (str_eq(callee, "sqrt")           || str_eq(callee, "fabs")          ||
        str_eq(callee, "pow")            || str_eq(callee, "floor")         ||
        str_eq(callee, "ceil")           || str_eq(callee, "int64_to_float64")) {
        ncg_last_ty = 2;
    }
    return 0;
}

// ── Statement codegen ─────────────────────────────────────────────────────────
fn ncg_stmt(int64 node) -> int64 {
    let kind = nd_kind[node];

    // let / mut declaration
    if (kind == ND_LET) {
        let name    = nd_sv[node];
        let init    = nd_i3[node];
        let is_flt  = 0;   // TODO: detect float type from init
        let slot    = local_def(name, is_flt);
        let off     = local_offset(slot);
        let r       = ncg_expr(init);
        // Record string, float, and struct types for future loads of this local.
        if (ncg_last_ty == 1) { local_set_str(slot, 1); }
        if (ncg_last_ty == 2) { local_set_float(slot, 1); }
        if (!str_eq(ncg_last_stype, "")) { local_set_stype(slot, ncg_last_stype); }
        // Store to stack
        if (off >= 0) { a64_str(r, REG_X29, off >> 3); }
        else {
            let neg = 0 - off;
            if (neg <= 255) { a64_stur(r, REG_X29, off); }
            else {
                a64_sub_imm(REG_X16, REG_X29, neg);
                a64_str(r, REG_X16, 0);
            }
        }
        scratch_pop();
        return 0;
    }

    // Assignment: name = expr  or  arr[i] = expr
    if (kind == ND_ASSIGN) {
        let target = nd_i2[node];
        let val    = nd_i3[node];
        let vr     = ncg_expr(val);

        let tkind = nd_kind[target];
        if (tkind == ND_IDENT) {
            let name = nd_sv[target];
            let slot = local_find(name);
            if (slot >= 0) {
                if (slot < n_csr) {
                    // Register-promoted param: write to callee-saved reg X19+slot
                    a64_mov(REG_X19 + slot, vr);
                } else {
                    let off  = local_offset(slot);
                    if (off >= 0) { a64_str(vr, REG_X29, off >> 3); }
                    else {
                        let neg = 0 - off;
                        if (neg <= 255) { a64_stur(vr, REG_X29, off); }
                        else {
                            a64_sub_imm(REG_X16, REG_X29, neg);
                            a64_str(vr, REG_X16, 0);
                        }
                    }
                }
            } else {
                // Not a local — store to global data slot
                let gi = ncg_glob_find(name);
                if (gi >= 0) {
                    a64_adrp_add(REG_X16, glob_syms[gi]);
                    a64_str(vr, REG_X16, 0);
                } else {
                    let sym_name = str_concat("_g_", name);
                    let sym_idx  = sym_undef(sym_name);
                    a64_adrp_add(REG_X16, sym_idx);
                    a64_str(vr, REG_X16, 0);
                }
            }
        }
        if (tkind == ND_INDEX) {
            // ionic_array_set(ptr arr, i64 idx, i64 val)
            let arr_r = ncg_expr(nd_i2[target]);
            let idx_r = ncg_expr(nd_i3[target]);
            let sym   = sym_undef("ionic_array_set");
            a64_mov(REG_X0, arr_r);
            a64_mov(REG_X1, idx_r);
            a64_mov(REG_X2, vr);
            a64_bl_sym(sym);
            scratch_pop();
            scratch_pop();
        }
        if (tkind == ND_FIELD_ACCESS) {
            // STR val to [obj + field_idx * 8]
            let obj_node_a = nd_i2[target];
            let field_a    = nd_sv[target];
            let obj_r_a    = ncg_expr(obj_node_a);
            let sname_a    = ncg_last_stype;
            let st_a       = st_find(sname_a);
            mut fidx_a     = 0;
            if (st_a != 0) {
                let fo_a = st_field_offset(st_a, field_a);
                if (fo_a >= 0) { fidx_a = fo_a; }
            }
            a64_str(vr, obj_r_a, fidx_a);
            scratch_pop();   // obj_r_a
        }
        scratch_pop();
        return 0;
    }

    // return expr
    if (kind == ND_RETURN) {
        let val = nd_i2[node];
        if (val != 0) {
            let r = ncg_expr(val);
            a64_mov(REG_X0, r);
            scratch_pop();
        }
        // Epilogue inline (jump to epilogue label would be cleaner but this works)
        ncg_fn_epilogue();
        return 0;
    }

    // if (cond) { ... } else { ... }
    if (kind == ND_IF) {
        let cond_node   = nd_i2[node];
        let then_block  = nd_i3[node];   // ND_BLOCK
        let else_block  = nd_i4[node];   // ND_BLOCK or 0
        let then_list   = nd_i2[then_block];
        mut else_list   = 0;
        if (else_block != 0) { else_list = nd_i2[else_block]; }

        let cr = ncg_expr(cond_node);
        scratch_pop();

        // CBZ cr, else_label
        let patch_else = a64_cbz(cr, 0);

        ncg_stmts(then_list);

        if (else_block != 0) {
            let patch_end = a64_b(0);
            let else_addr = text_len();
            a64_patch_bcond(patch_else, else_addr);
            ncg_stmts(else_list);
            let end_addr = text_len();
            a64_patch_b(patch_end, end_addr);
        } else {
            let end_addr = text_len();
            a64_patch_bcond(patch_else, end_addr);
        }
        return 0;
    }

    // while (cond) { body }
    if (kind == ND_WHILE) {
        let cond_node  = nd_i2[node];
        let body_block = nd_i3[node];    // ND_BLOCK
        let body_list  = nd_i2[body_block];

        let loop_top = text_len();
        let cr = ncg_expr(cond_node);
        scratch_pop();
        let patch_exit = a64_cbz(cr, 0);
        ncg_stmts(body_list);
        a64_b(loop_top - text_len());   // back-edge (negative offset)
        let exit_addr = text_len();
        a64_patch_bcond(patch_exit, exit_addr);
        return 0;
    }

    // for (i in start..end) { body }
    if (kind == ND_FOR) {
        let var_name   = nd_sv[node];
        let start_nd   = nd_i2[node];
        let end_nd     = nd_i3[node];
        let body_block = nd_i4[node];    // ND_BLOCK
        let body_list  = nd_i2[body_block];

        // init i
        let slot = local_def(var_name, 0);
        let off  = local_offset(slot);
        let sr   = ncg_expr(start_nd);
        scratch_pop();
        a64_store_fp(sr, off);

        // loop condition
        let loop_top = text_len();
        let ir = scratch_push();
        a64_load_fp(ir, off);
        let er = ncg_expr(end_nd);
        a64_cmp(ir, er);
        scratch_pop();
        scratch_pop();
        let patch_exit = a64_bcond(COND_GE, 0);   // exit if i >= end

        ncg_stmts(body_list);

        // i = i + 1
        let ir2 = scratch_push();
        a64_load_fp(ir2, off);
        a64_add_imm(ir2, ir2, 1);
        a64_store_fp(ir2, off);
        scratch_pop();

        a64_b(loop_top - text_len());
        let exit_addr = text_len();
        a64_patch_bcond(patch_exit, exit_addr);
        return 0;
    }

    // Standalone expression (call statement)
    if (kind == ND_EXPR_STMT) {
        let r = ncg_expr(nd_i2[node]);
        scratch_pop();
        return 0;
    }

    // gpu {} block — type-checked by checker; emit body as regular code
    if (kind == ND_GPU_BLOCK) {
        ncg_stmts(nd_i2[nd_i2[node]]);
        return 0;
    }

    return 0;
}

fn ncg_stmts(int64 list) -> int64 {
    mut node = list;
    while (node != 0) {
        ncg_stmt(nd_i2[node]);
        node = nd_i3[node];
    }
    return 0;
}

// ── Function prologue / epilogue ──────────────────────────────────────────────
mut cur_frame_size = 0;

fn ncg_fn_prologue(int64 n_locals) -> int64 {
    cur_frame_size = frame_size(n_locals);
    let fs = cur_frame_size;
    if (fs <= 504) {
        // Small frame (≤504): STP pre-indexed with negative imm7 (-63..-1)
        let imm7 = (0 - fs) >> 3;
        a64_stp_pre(REG_X29, REG_X30, REG_SP, imm7);
    } else {
        // Large frame: SUB SP first, then STP at offset 0
        if (fs <= 4095) {
            a64_sub_imm(REG_SP, REG_SP, fs);
        } else {
            a64_load_imm(REG_X17, fs);
            a64_sub(REG_SP, REG_SP, REG_X17);
        }
        a64_stp(REG_X29, REG_X30, REG_SP, 0);
    }
    a64_add_imm(REG_X29, REG_SP, 0);
    // Save callee-saved param regs X19..X(19+n_csr-1) into CSR save area
    mut csi = 0;
    while (csi < n_csr) {
        a64_store_fp(REG_X19 + csi, (csr_base_slot + 2 + csi) * 8);
        csi = csi + 1;
    }
    return 0;
}

fn ncg_fn_epilogue() -> int64 {
    // Restore callee-saved param regs before tearing down the frame
    mut csi = 0;
    while (csi < n_csr) {
        a64_load_fp(REG_X19 + csi, (csr_base_slot + 2 + csi) * 8);
        csi = csi + 1;
    }
    a64_add_imm(REG_SP, REG_X29, 0);
    let fs = cur_frame_size;
    if (fs <= 504) {
        // Small frame: LDP post-indexed
        let imm7 = fs >> 3;
        a64_ldp_post(REG_X29, REG_X30, REG_SP, imm7);
    } else {
        // Large frame: LDP at offset 0, then ADD SP
        a64_ldp(REG_X29, REG_X30, REG_SP, 0);
        if (fs <= 4095) {
            a64_add_imm(REG_SP, REG_SP, fs);
        } else {
            a64_load_imm(REG_X17, fs);
            a64_add(REG_SP, REG_SP, REG_X17);
        }
    }
    a64_ret();
    return 0;
}

fn count_locals_deep(int64 list) -> int64 {
    mut n = 0;
    mut node = list;
    while (node != 0) {
        let stmt = nd_i2[node];
        let k = nd_kind[stmt];
        if (k == ND_LET) { n = n + 1; }
        if (k == ND_IF) {
            let then_block = nd_i3[stmt];
            let else_block = nd_i4[stmt];
            n = n + count_locals_deep(nd_i2[then_block]);
            if (else_block != 0) {
                n = n + count_locals_deep(nd_i2[else_block]);
            }
        }
        if (k == ND_WHILE) {
            let body_block = nd_i3[stmt];
            n = n + count_locals_deep(nd_i2[body_block]);
        }
        if (k == ND_FOR) {
            n = n + 1;   // loop variable counts as a local
            let body_block = nd_i4[stmt];
            n = n + count_locals_deep(nd_i2[body_block]);
        }
        node = nd_i3[node];
    }
    return n;
}

fn count_locals(int64 list) -> int64 {
    // +8 for CSR save slots (X19..X26) + 8 for scratch spill slots (X9..X15)
    return count_locals_deep(list) + 16;
}

// ── Function codegen ──────────────────────────────────────────────────────────
fn ncg_fn_node(int64 fn_node) -> int64 {
    let raw_name   = nd_sv[fn_node];
    let params     = nd_i2[fn_node];
    // nd_i3 = ret_ty, nd_i4 = body (ND_BLOCK); stmt list is nd_i2 of the block
    let body_block = nd_i4[fn_node];
    let body_list  = nd_i2[body_block];

    // Rename user fn main() → ionic_user_main to avoid collision with the C entry point.
    mut name = raw_name;
    if (str_eq(raw_name, "main") && params == 0) {
        name = "ionic_user_main";
        ncg_has_user_main = 1;
    }

    local_reset();
    scratch_depth = 0;

    // Count params + body locals for frame sizing
    mut n_params = 0;
    mut pc = params;
    while (pc != 0) { n_params = n_params + 1; pc = nd_i3[pc]; }
    let n_body_base = count_locals_deep(body_list);
    // Promote all params (up to 8) to callee-saved regs X19..X(19+n_params-1)
    mut n_prom = n_params;
    if (n_prom > 8) { n_prom = 8; }
    n_csr         = n_prom;
    csr_base_slot = n_params + n_body_base;      // CSR saves after all locals
    spill_base    = n_params + n_body_base + 8;  // scratch spills after CSR saves
    let n_locals  = n_params + n_body_base + 16; // 8 CSR + 8 scratch headroom

    // Register as defined global symbol
    let fn_addr = text_len();
    sym_add(name, SYM_DEFINED, 1, fn_addr);

    // Move incoming args (X0-X7) to stack slots for each parameter
    mut param_node = params;
    mut pi = 0;
    while (param_node != 0) {
        let pn      = nd_i2[param_node];
        let param_name = nd_sv[pn];
        let slot = local_def(param_name, 0);  // TODO detect float param
        // If parameter type is a named struct, record it for field-access resolution.
        let param_ty = nd_i2[pn];   // type node of this param
        if (nd_kind[param_ty] == ND_TY_NAMED) {
            local_set_stype(slot, nd_sv[param_ty]);
        }
        let off  = local_offset(slot);
        // Prologue happens before we store params, so store after prologue
        param_node = nd_i3[param_node];
        pi = pi + 1;
    }

    ncg_fn_prologue(n_locals);

    // Move incoming args X0..X7 to their destinations.
    // Promoted params (slot < n_csr) go to callee-saved X19+slot.
    // Remaining params go to stack slots.
    mut pn2 = params;
    mut pi2 = 0;
    while (pn2 != 0) {
        let pname = nd_sv[nd_i2[pn2]];
        let slot  = local_find(pname);
        if (slot < n_csr) {
            a64_mov(REG_X19 + slot, pi2);
        } else {
            let off = local_offset(slot);
            a64_store_fp(pi2, off);
        }
        pn2 = nd_i3[pn2];
        pi2 = pi2 + 1;
    }

    ncg_stmts(body_list);

    // Implicit return 0 at end of function if no explicit return
    a64_load_imm(REG_X0, 0);
    ncg_fn_epilogue();

    buf_align(text_buf, 4);
    return 0;
}

// ── main() wrapper ─────────────────────────────────────────────────────────────
fn ncg_main_wrapper(int64 top_list) -> int64 {
    let fn_addr = text_len();
    sym_add("main", SYM_DEFINED, 1, fn_addr);

    local_reset();
    scratch_depth = 0;
    let mw_deep = count_locals_deep(top_list);
    n_csr = 0;
    csr_base_slot = mw_deep + 4;
    spill_base    = mw_deep + 4 + 8;   // skip CSR area (n_csr=0 but reserve slots)
    let n_locals  = mw_deep + 4 + 16;  // 4 slack + 8 CSR + 8 scratch headroom
    ncg_fn_prologue(n_locals);

    // Call ionic_runtime_init(argc, argv)
    let init_sym = sym_undef("ionic_runtime_init");
    // X0 = argc, X1 = argv are already in regs from the OS
    // Save them to the frame then pass to init
    a64_store_fp(REG_X0, local_offset(local_def("__argc", 0)));
    a64_store_fp(REG_X1, local_offset(local_def("__argv", 0)));
    a64_bl_sym(init_sym);

    // Process top-level statements.
    // ND_LET nodes are handled via the global tables built by ncg_build_globals.
    // Integer constants are already inlined — skip them here.
    // Non-constant globals need their init expression evaluated and stored.
    mut tl = top_list;
    while (tl != 0) {
        let stmt = nd_i2[tl];
        if (nd_kind[stmt] == ND_LET) {
            let gname = nd_sv[stmt];
            let ginit = nd_i3[stmt];
            // If it's a compile-time constant (inlined), skip runtime init
            let cki = ncg_const_find(gname);
            if (cki < 0) {
                // Global variable — evaluate init and store to __data slot
                let gi = ncg_glob_find(gname);
                if (gi >= 0) {
                    let ir = ncg_expr(ginit);
                    if (ncg_last_ty == 1) { glob_is_str[gi]   = 1; }
                    if (ncg_last_ty == 2) { glob_is_float[gi] = 1; }
                    a64_adrp_add(REG_X16, glob_syms[gi]);
                    a64_str(ir, REG_X16, 0);
                    scratch_pop();
                }
            }
        } else {
            ncg_stmt(stmt);
        }
        tl = nd_i3[tl];
    }

    // Call ionic_user_main() if one exists
    if (ncg_has_user_main == 1) {
        let um_sym = sym_undef("ionic_user_main");
        a64_bl_sym(um_sym);
    }

    a64_load_imm(REG_X0, 0);
    ncg_fn_epilogue();
    return 0;
}

// ── Global pre-pass: build constant and variable tables ───────────────────────
// Called from codegen_program before emitting any functions.
fn ncg_build_globals(int64 top_list) -> int64 {
    mut cl = top_list;
    while (cl != 0) {
        let stmt = nd_i2[cl];
        if (nd_kind[stmt] == ND_LET) {
            let gname = nd_sv[stmt];
            let ginit = nd_i3[stmt];
            let is_mut = nd_iv[stmt];   // 0=let, 1=mut
            if (is_mut == 0 && nd_kind[ginit] == ND_INT) {
                // Immutable integer constant — inline at use sites
                const_names.push(str_hash(gname));
                const_vals.push(nd_iv[ginit]);
                const_count = const_count + 1;
            } else {
                // Mutable global or non-integer let — allocate 8-byte slot in __data
                let sym_name = str_concat("_g_", gname);
                let slot_off = glob_buf.len;
                mut bi = 0;
                while (bi < 8) { glob_buf.push(0); bi = bi + 1; }
                let sym_idx = sym_add(sym_name, SYM_DEFINED, 3, slot_off);
                glob_names.push(str_hash(gname));
                glob_syms.push(sym_idx);
                glob_is_str.push(0);
                glob_is_float.push(0);
                glob_count = glob_count + 1;
            }
        }
        cl = nd_i3[cl];
    }
    return 0;
}

// ── Mach-O object file writer ─────────────────────────────────────────────────
// Constants
let MH_MAGIC_64    = 4277009103;  // 0xFEEDFACF
let CPU_TYPE_ARM64 = 16777228;    // 0x0100000C
let MH_OBJECT      = 1;
let MH_SUBSECTIONS = 8192;        // 0x2000
let LC_SEGMENT_64     = 25;        // 0x19
let LC_SYMTAB         = 2;
let LC_DYSYMTAB       = 11;
let LC_BUILD_VERSION  = 50;        // 0x32 — required by macOS linker
let PLATFORM_MACOS    = 1;

fn write_macho(string out_path) -> int64 {
    mut out = [0]; arr_reset(out);   // empty — no sentinel

    // Align section data.
    // Globals need (text_size + data_size) to be 8-byte aligned so their slot offsets
    // are correct after the linker places __data.  Pad data_buf to achieve this.
    buf_align(text_buf, 4);
    let align_total = text_buf.len + data_buf.len;
    let align_need = (8 - (align_total & 7)) & 7;
    mut align_pi = 0;
    while (align_pi < align_need) { data_buf.push(0); align_pi = align_pi + 1; }

    let text_size = text_buf.len;
    let data_size = data_buf.len;
    let glob_size = glob_buf.len;
    let n_sects   = 3;   // __text, __cstring, __data

    // Offsets: header → load commands → section data → relocations → symtab → strtab
    // mach_header_64: 32 bytes
    // LC_SEGMENT_64 with 2 sections: 72 + 2*80 = 232 bytes
    // LC_SYMTAB: 24 bytes
    // Total load commands: 232 + 24 = 256 bytes
    let hdr_size      = 32;
    let seg_sz        = 72 + n_sects * 80;
    let build_lc_sz   = 24;
    let sym_lc_sz     = 24;
    let lc_total      = seg_sz + build_lc_sz + sym_lc_sz;

    let text_off   = hdr_size + lc_total;
    let data_off   = text_off + text_size;
    let glob_off   = data_off + data_size;

    // Relocations follow section data (each entry = 8 bytes)
    let text_reloc_off = glob_off + glob_size;
    let n_text_reloc   = reloc_count;
    let reloc_total    = n_text_reloc * 8;

    // Symbol table (nlist_64 = 16 bytes each)
    let sym_off  = text_reloc_off + reloc_total;
    let str_off  = sym_off + sym_count * 16;
    let str_size = strtab_buf.len;

    // ── mach_header_64 ─────────────────────────────────────────────────────
    buf_u32(out, MH_MAGIC_64);
    buf_u32(out, CPU_TYPE_ARM64);
    buf_u32(out, 0);               // cpusubtype: ARM64_ALL
    buf_u32(out, MH_OBJECT);
    buf_u32(out, 3);               // ncmds
    buf_u32(out, lc_total);        // sizeofcmds
    buf_u32(out, MH_SUBSECTIONS);
    buf_u32(out, 0);               // reserved

    // ── LC_SEGMENT_64 ──────────────────────────────────────────────────────
    buf_u32(out, LC_SEGMENT_64);
    buf_u32(out, seg_sz);          // cmdsize
    // segname: 16 bytes of ""
    mut si = 0;
    while (si < 16) { buf_u8b(out, 0); si = si + 1; }
    buf_u64(out, 0);               // vmaddr
    buf_u64(out, text_size + data_size + glob_size);  // vmsize
    buf_u64(out, text_off);        // fileoff
    buf_u64(out, text_size + data_size + glob_size);  // filesize
    buf_u32(out, 7);               // maxprot  (rwx)
    buf_u32(out, 7);               // initprot
    buf_u32(out, n_sects);
    buf_u32(out, 0);               // flags

    // section_64 for __text
    // sectname: "__text" + padding to 16
    let text_sec_name = "__text";
    mut ci = 0;
    while (ci < str_len(text_sec_name)) { buf_u8b(out, str_index(text_sec_name, ci)); ci = ci + 1; }
    while (ci < 16) { buf_u8b(out, 0); ci = ci + 1; }
    // segname: "__TEXT"
    let text_seg_name = "__TEXT";
    mut di = 0;
    while (di < str_len(text_seg_name)) { buf_u8b(out, str_index(text_seg_name, di)); di = di + 1; }
    while (di < 16) { buf_u8b(out, 0); di = di + 1; }
    buf_u64(out, 0);               // addr
    buf_u64(out, text_size);       // size
    buf_u32(out, text_off);        // offset
    buf_u32(out, 2);               // align = 2^2 = 4
    buf_u32(out, text_reloc_off);  // reloff
    buf_u32(out, n_text_reloc);    // nreloc
    buf_u32(out, 2147484672);      // flags: S_ATTR_SOME_INSTRUCTIONS|S_ATTR_PURE_INSTRUCTIONS = 0x80000400
    buf_u32(out, 0); buf_u32(out, 0); buf_u32(out, 0);   // reserved

    // section_64 for __cstring
    let cstr_sec_name = "__cstring";
    mut ei = 0;
    while (ei < str_len(cstr_sec_name)) { buf_u8b(out, str_index(cstr_sec_name, ei)); ei = ei + 1; }
    while (ei < 16) { buf_u8b(out, 0); ei = ei + 1; }
    let cstr_seg_name = "__TEXT";
    mut fi = 0;
    while (fi < str_len(cstr_seg_name)) { buf_u8b(out, str_index(cstr_seg_name, fi)); fi = fi + 1; }
    while (fi < 16) { buf_u8b(out, 0); fi = fi + 1; }
    buf_u64(out, text_size);       // addr (follows __text in vmspace)
    buf_u64(out, data_size);       // size
    buf_u32(out, data_off);        // offset
    buf_u32(out, 0);               // align = 1
    buf_u32(out, 0);               // reloff (no relocations for cstring)
    buf_u32(out, 0);               // nreloc
    buf_u32(out, 2);               // flags: S_CSTRING_LITERALS
    buf_u32(out, 0); buf_u32(out, 0); buf_u32(out, 0);

    // section_64 for __data (__DATA segment, mutable globals)
    let data_sec_name = "__data";
    mut gi2 = 0;
    while (gi2 < str_len(data_sec_name)) { buf_u8b(out, str_index(data_sec_name, gi2)); gi2 = gi2 + 1; }
    while (gi2 < 16) { buf_u8b(out, 0); gi2 = gi2 + 1; }
    let data_seg_name = "__DATA";
    mut hi = 0;
    while (hi < str_len(data_seg_name)) { buf_u8b(out, str_index(data_seg_name, hi)); hi = hi + 1; }
    while (hi < 16) { buf_u8b(out, 0); hi = hi + 1; }
    buf_u64(out, text_size + data_size);  // addr (follows __text and __cstring)
    buf_u64(out, glob_size);              // size
    buf_u32(out, glob_off);               // offset
    buf_u32(out, 3);                      // align = 2^3 = 8 bytes
    buf_u32(out, 0);                      // reloff
    buf_u32(out, 0);                      // nreloc
    buf_u32(out, 0);                      // flags: S_REGULAR
    buf_u32(out, 0); buf_u32(out, 0); buf_u32(out, 0);

    // ── LC_BUILD_VERSION ───────────────────────────────────────────────────
    buf_u32(out, LC_BUILD_VERSION);
    buf_u32(out, build_lc_sz);
    buf_u32(out, PLATFORM_MACOS);  // macOS
    buf_u32(out, 786432);          // minos = 12.0.0
    buf_u32(out, 0);               // sdk = 0
    buf_u32(out, 0);               // ntools = 0

    // ── LC_SYMTAB ──────────────────────────────────────────────────────────
    buf_u32(out, LC_SYMTAB);
    buf_u32(out, sym_lc_sz);
    buf_u32(out, sym_off);
    buf_u32(out, sym_count);
    buf_u32(out, str_off);
    buf_u32(out, str_size);

    // ── Section data ───────────────────────────────────────────────────────
    // __text
    let tlen = text_buf.len;
    mut ti = 0;
    while (ti < tlen) { buf_u8b(out, text_buf[ti]); ti = ti + 1; }
    // __cstring
    let dlen = data_buf.len;
    mut ddi = 0;
    while (ddi < dlen) { buf_u8b(out, data_buf[ddi]); ddi = ddi + 1; }
    // __data (mutable globals, zero-initialized, runtime-set)
    let glen = glob_buf.len;
    mut gli = 0;
    while (gli < glen) { buf_u8b(out, glob_buf[gli]); gli = gli + 1; }

    // ── Relocations ────────────────────────────────────────────────────────
    // relocation_info: { r_address(4), r_symbolnum:24, r_pcrel:1, r_length:2, r_extern:1, r_type:4 }
    mut ri = 0;
    while (ri < reloc_count) {
        let base  = ri * RELOC_STRIDE;
        let raddr = reloc_buf[base];
        let rsym  = reloc_buf[base + 1];
        let rtype = reloc_buf[base + 2];
        let rpcrel = reloc_buf[base + 3];
        let rext  = reloc_buf[base + 4];
        buf_u32(out, raddr);
        // Pack: bits[31:24]=type, bit[24]=extern, bit[25:24]=length(=2 for 4-byte), bit[28]=pcrel
        let info = (rtype << 28) | (rpcrel << 24) | (2 << 25) | (rext << 27) | (rsym & 16777215);
        buf_u32(out, info);
        ri = ri + 1;
    }

    // ── Symbol table (nlist_64, 16 bytes each) ─────────────────────────────
    let sbase = sym_count * SYM_STRIDE;
    mut symi = 0;
    while (symi < sym_count) {
        let sb  = symi * SYM_STRIDE;
        let strx = sym_buf[sb];
        let stype = sym_buf[sb + 1];
        let ssect = sym_buf[sb + 2];
        let sdesc = sym_buf[sb + 3];
        let sval  = sym_buf[sb + 4];
        // Adjust symbol value to vmaddr within segment
        mut real_val = sval;
        if (ssect == 2) { real_val = text_size + sval; }
        if (ssect == 3) { real_val = text_size + data_size + sval; }
        buf_u32(out, strx);           // n_strx
        buf_u8b(out, stype);          // n_type
        buf_u8b(out, ssect);          // n_sect
        buf_u16(out, sdesc);          // n_desc
        buf_u64(out, real_val);       // n_value
        symi = symi + 1;
    }

    // ── String table ───────────────────────────────────────────────────────
    let stlen = strtab_buf.len;
    mut sti = 0;
    while (sti < stlen) { buf_u8b(out, strtab_buf[sti]); sti = sti + 1; }

    // Write to disk
    file_write_binary(out, out_path);
    return 0;
}

// ── Top-level entry point ─────────────────────────────────────────────────────
fn codegen_program(int64 structs_list, int64 fns_list, int64 top_list, string out_path) -> int64 {
    // Reset all global state — arr_reset clears length to 0, removing sentinel
    text_buf     = [0]; arr_reset(text_buf);
    data_buf     = [0]; arr_reset(data_buf);
    reloc_buf    = [0]; arr_reset(reloc_buf);
    reloc_count  = 0;
    sym_buf      = [0]; arr_reset(sym_buf);
    sym_count    = 0;
    strtab_buf   = [0]; arr_reset(strtab_buf);
    strtab_len   = 0;
    cstr_offsets = [0]; arr_reset(cstr_offsets);
    cstr_count   = 0;
    local_names    = [0]; arr_reset(local_names);
    local_slots    = [0]; arr_reset(local_slots);
    local_is_float = [0]; arr_reset(local_is_float);
    local_is_str   = [0]; arr_reset(local_is_str);
    local_stypes   = [""]; arr_reset(local_stypes);
    local_count    = 0;
    scratch_depth  = 0;
    fn_ret_stype_hashes = [0]; arr_reset(fn_ret_stype_hashes);
    fn_ret_stypes       = [""]; arr_reset(fn_ret_stypes);
    fn_ret_count        = 0;
    ncg_has_user_main = 0;
    ncg_last_stype = "";
    const_names  = [0]; arr_reset(const_names);  const_count = 0;
    const_vals   = [0]; arr_reset(const_vals);
    glob_names   = [0]; arr_reset(glob_names);   glob_count  = 0;
    glob_syms    = [0]; arr_reset(glob_syms);
    glob_is_str   = [0]; arr_reset(glob_is_str);
    glob_is_float = [0]; arr_reset(glob_is_float);
    glob_buf      = [0]; arr_reset(glob_buf);
    strtab_init();

    // Build function return-struct-type table for field-access resolution
    mut frt_node = fns_list;
    while (frt_node != 0) {
        let fndef  = nd_i2[frt_node];
        let rty    = nd_i3[fndef];
        if (nd_kind[rty] == ND_TY_NAMED) {
            fn_ret_stype_hashes.push(str_hash(nd_sv[fndef]));
            fn_ret_stypes.push(nd_sv[rty]);
            fn_ret_count = fn_ret_count + 1;
        }
        frt_node = nd_i3[frt_node];
    }

    // Build global constant + variable tables from top-level declarations
    ncg_build_globals(top_list);

    // Emit all functions
    mut fn_node = fns_list;
    while (fn_node != 0) {
        ncg_fn_node(nd_i2[fn_node]);
        fn_node = nd_i3[fn_node];
    }

    // Always emit the C entry point main()
    ncg_main_wrapper(top_list);

    // Write the object file
    write_macho(out_path);
    return 0;
}
